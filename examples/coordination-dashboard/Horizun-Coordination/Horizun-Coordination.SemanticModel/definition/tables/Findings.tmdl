	partition Findings = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(LedgerCsvPath), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"finding_id", type text}, {"status", type text}, {"assignee", type text}, {"note", type text}, {"category_a", type text}, {"category_b", type text}, {"side_a", type text}, {"side_b", type text}, {"point_mm", type text}, {"first_seen_utc", type datetimezone}, {"last_seen_utc", type datetimezone}, {"resolved_utc", type datetimezone}, {"times_seen", Int64.Type}, {"regression", type logical}, {"scope", type text}, {"external_source", type text}, {"external_issue_id", type text}, {"priority", type text}, {"responsible", type text}, {"immovable_discipline", type text}}, "en-US"),
				    #"Source Label" = Table.ReplaceValue(#"Changed Type", "", "horizun_clash", Replacer.ReplaceValue, {"external_source"})
				in
				    #"Source Label"

	annotation PBI_ResultType = Table
