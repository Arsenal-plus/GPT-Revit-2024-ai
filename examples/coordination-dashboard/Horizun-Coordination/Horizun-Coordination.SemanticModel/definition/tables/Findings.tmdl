/// Coordination findings exported by horizun_coordination operation=export format=csv (one row per clash pair).
table Findings
	lineageTag: 25ec4d3b-a1de-4f9f-93f3-6d04144b74f6

	measure 'Open Critical or High' = CALCULATE ( [Open Findings], Findings[priority] IN { "critical", "high" } )
		formatString: #,0
		displayFolder: Coordination
		lineageTag: 384507ba-cac5-499f-b010-30c0c5dd7d50

	measure 'Resolution Rate' = DIVIDE ( [Resolved by Model], [Findings Total] )
		formatString: 0.0%
		displayFolder: Coordination
		lineageTag: 9e083b45-4eb2-46e0-a2a3-66a5de6e6b19

	/// Pairs that came back after being resolved.
	measure Regressions = CALCULATE ( COUNTROWS ( Findings ), Findings[regression] = TRUE () )
		formatString: #,0
		displayFolder: Coordination
		lineageTag: c13ad0ed-45cb-4e5e-bddd-9c58deb97d5f

	/// Pairs a person accepted or closed; they are still in the model.
	measure 'Closed by Decision' = CALCULATE ( COUNTROWS ( Findings ), Findings[status] IN { "accepted_risk", "closed_by_decision" } )
		formatString: #,0
		displayFolder: Coordination
		lineageTag: dd390966-9938-488e-b987-3b7a4a53c5b0

	/// Pairs a complete detection run measured as gone - never set by hand.
	measure 'Resolved by Model' = CALCULATE ( COUNTROWS ( Findings ), Findings[status] = "resolved_by_model" )
		formatString: #,0
		displayFolder: Coordination
		lineageTag: 18b51c52-5171-4820-b1fc-7fd63eb0e029

	/// Clash pairs still in the model: status open or assigned.
	measure 'Open Findings' = CALCULATE ( COUNTROWS ( Findings ), Findings[status] IN { "open", "assigned" } )
		formatString: #,0
		displayFolder: Coordination
		lineageTag: c7dd1111-2bfc-48ff-b6ef-d54b90987781

	measure 'Findings Total' = COUNTROWS ( Findings )
		formatString: #,0
		displayFolder: Coordination
		lineageTag: d3bdb371-a096-499d-bee5-5082143895cf

	column finding_id
		dataType: string
